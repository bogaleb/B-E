# Copy to .env.local for local development. On Vercel, add these in Project → Settings → Environment Variables.
# Never commit real values.

# Public site URL (no trailing slash). Leave empty on Vercel previews to use the preview URL automatically.
NEXT_PUBLIC_SITE_URL=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security — used to store form submissions and run rate limiting.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com) — optional until you're ready to send email.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend. Until then Resend only delivers to your own account email.
RESEND_FROM_EMAIL="ETHIO Foods <orders@your-domain.com>"
# Where new-request notifications go. Comma-separate multiple addresses.
ADMIN_NOTIFICATION_EMAIL=

# Random string used to hash visitor IP addresses for abuse prevention. Generate with: openssl rand -hex 32
IP_HASH_SALT=

# Accept forms without a database (design previews only). Defaults to true in development, false in production.
ALLOW_DEMO_SUBMISSIONS=
